OPENAI_API_KEY=replace-with-openai-key
OPENAI_MODEL=replace-with-openai-model
OPENAI_TIMEOUT_SECONDS=20
OPENAI_REASONING_EFFORT_CLASSIFY=
LLM_CONSECUTIVE_FAILURE_THRESHOLD=5
LLM_DEGRADED_FAILURE_SHARE=0.10
STAGE2_LLM_FALLBACK=0
SUPABASE_URL=replace-with-supabase-url
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
DATA_DIR=../data
# Leave empty for any localhost development port. Set your Vercel URL in production.
ALLOWED_ORIGINS=
